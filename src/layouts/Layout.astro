---
import { site } from "../config";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  type?: "profile" | "article" | "website";
  publishedTime?: Date;
}

const {
  title = site.name,
  description = "software engineer from Kazakhstan",
  type = "profile",
  publishedTime,
} = Astro.props;
const documentTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonicalUrl = new URL(Astro.url.pathname, site.url).toString();
const publishedDate = publishedTime && [
  publishedTime.getFullYear(),
  String(publishedTime.getMonth() + 1).padStart(2, "0"),
  String(publishedTime.getDate()).padStart(2, "0"),
].join("-");
const author = { name: "Vitalya Volynskiy", url: site.url };
const articleJsonLd = type === "article" && JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: publishedDate,
  author: { "@type": "Person", ...author },
  mainEntityOfPage: canonicalUrl,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="Vitalya's blog" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#35374b">
    <meta name="author" content="Vitalya Volynskiy">

    <meta property="og:type" content={type} />
    <!-- <meta property="og:image" content='https://vitalya.me/og-image.png'/> -->
    <meta property="og:title" content={title} />
    <meta property="og:locale" content="en_US" />
    <meta name="description" content={description} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    {type === "profile" && (
      <>
        <meta property="profile:first_name" content="Vitalya">
        <meta property="profile:last_name" content="Volynskiy">
        <meta property="profile:gender" content="male">
        <meta property="profile:username" content="vitalyavolyn">
      </>
    )}
    {type === "article" && (
      <>
        {publishedDate && <meta property="article:published_time" content={publishedDate} />}
        <meta property="article:author" content={author.url} />
        <script type="application/ld+json" set:html={articleJsonLd} />
      </>
    )}

    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{documentTitle}</title>
  </head>
  <body>
    <div class="balls" />
    <slot />
  </body>
</html>

<style>
  html,
  body {
    background-color: var(--bg);
    color: var(--text);
    margin: 0;
    width: 100%;
    height: 100%;
  }

  .balls {
    position: fixed;
    top: -10vw;
    left: -10vw;
    right: 0;
    bottom: 0;
    image-rendering: pixelated;
    background: url(/balls.png) repeat;
    background-size: 10vw 10vw;
    will-change: transform;
    animation: slideBackground 13s linear infinite;
  }

  @keyframes slideBackground {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(10vw, 10vw, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .balls {
      animation: none;
    }
  }
</style>
