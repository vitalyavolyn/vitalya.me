---
import { getCollection } from "astro:content";
import Nav from "../../components/Nav.astro";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog") as any[])
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    ...post,
    date: post.data.pubDate.toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
    }).replace(",", ""),
  }));
---
<Layout title="blog" description="articles by Vitalya Volynskiy" type="website">
  <div class="container w-full grow py-8 mx-auto flex max-w-3xl flex-col gap-2 px-5 sm:px-8 relative top-4">
    <Nav />
    <h1 class="text-4xl font-semibold">articles</h1>
    <div class="sm:pl-7 flex flex-col gap-3 sm:gap-1 posts">
      {posts.map((post) => <div class="flex flex-col sm:flex-row sm:gap-4">
        <a href={`/posts/${post.id}/`}>{post.data.title}</a>
        <div class="grow"></div>
        <span class="shrink-0 whitespace-nowrap text-sm sm:text-base opacity-70 sm:opacity-100">{post.date}</span>
      </div>)}
    </div>
  </div>
</Layout>

<style>
  .posts a {
    color: var(--text);
  }
</style>
