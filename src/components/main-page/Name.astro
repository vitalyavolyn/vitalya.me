<b id="name" class="cursor-pointer underline decoration-dotted">Vitalya</b>

<script>
  const names = ["Vitalya", "vitalä", 'виталя', 'vita', 'veetaleek']
  let index = 0;

  document.querySelector('#name')?.addEventListener('click', () => {
    index = (index + 1) % names.length;
    document.querySelector('#name')!.textContent = names[index];
  });
</script>
