---
interface Props {
  mapUrl: string;
}

const { mapUrl } = Astro.props;
---

<div id="map" style={`--map-url: url(${mapUrl})`}>
  <div class="map-container" />
</div>
<style>
  #map {
    width: 100%;
    background-color: var(--bg);
  }

  .map-container {
    background: var(--map-url);
    width: 100%;
    height: 230px;
    background-position: center;
    position: relative;
    background-size: cover;
  }
</style>
